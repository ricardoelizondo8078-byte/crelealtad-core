# Environment
NODE_ENV=development

# Server
PORT=3100

# Database - Opción 1: URL completa
DATABASE_URL=postgresql://usuario:CHANGE_ME@localhost:5432/crelealtad

# Database - Opción 2: Credenciales individuales
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME
DB_NAME=crelealtad
DB_SSL=false
# En producción la validación TLS está activa. Sólo desactívala de forma explícita
# si el proveedor documenta que usa un certificado no verificable.
DB_SSL_REJECT_UNAUTHORIZED=true

# JWT
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_SECRET

# CORS web de producción - Lista exacta de orígenes separados por comas.
# React Native nativo no requiere un origen CORS.
ALLOWED_ORIGINS=https://app.example.com

# Ruta persistente y respaldada para las versiones documentales.
# En desarrollo puede usarse ./runtime-data/documentos; producción debe montar almacenamiento durable.
DOCUMENT_STORAGE_PATH=./runtime-data/documentos

# Ruta persistente y respaldada para fotografías de evidencia de Verificación
# (llamadas y fachadas de Visita al vecino).
VERIFICACION_STORAGE_PATH=./runtime-data/verificacion-llamadas

# ⚠️ IMPORTANTE:
# 1. Copia este archivo a .env y configura tus valores reales
# 2. NUNCA commitees el archivo .env al repositorio
# 3. Cambia JWT_SECRET en producción a un valor aleatorio seguro
# 4. En producción, usa variables de entorno del sistema o un gestor de secretos
