# Environment
NODE_ENV=development

# Server
PORT=3100

# Database - Opción 1: URL completa
DATABASE_URL=postgresql://usuario@localhost:5432/crelealtad

# Database - Opción 2: Credenciales individuales
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=crelealtad

# JWT
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_SECRET_IN_PRODUCTION

# CORS - Lista de orígenes separados por comas
ALLOWED_ORIGINS=http://localhost:8081,http://192.168.1.*

# ⚠️ IMPORTANTE:
# 1. Copia este archivo a .env y configura tus valores reales
# 2. NUNCA commitees el archivo .env al repositorio
# 3. Cambia JWT_SECRET en producción a un valor aleatorio seguro
# 4. En producción, usa variables de entorno del sistema o un gestor de secretos
