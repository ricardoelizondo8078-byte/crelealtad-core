import { Test, TestingModule } from '@nestjs/testing';
import { getRepositoryToken } from '@nestjs/typeorm';
import { Repository } from 'typeorm';
import { GruposService } from './grupos.service';
import { GrupoEntity, GrupoStatus } from './grupo.entity';
import { ExpedientesService } from '../expedientes/expedientes.service';
import { ExpedienteEntity } from '../expedientes/expediente.entity';

describe('GruposService', () => {
  let service: GruposService;
  let grupoRepository: Repository<GrupoEntity>;
  let expedientesService: ExpedientesService;

  const mockGrupoRepository = {
    create: jest.fn(),
    save: jest.fn(),
    findOne: jest.fn(),
  };

  const mockExpedientesService = {
    createForGroup: jest.fn(),
  };

  beforeEach(async () => {
    const module: TestingModule = await Test.createTestingModule({
      providers: [
        GruposService,
        {
          provide: getRepositoryToken(GrupoEntity),
          useValue: mockGrupoRepository,
        },
        {
          provide: ExpedientesService,
          useValue: mockExpedientesService,
        },
      ],
    }).compile();

    service = module.get<GruposService>(GruposService);
    grupoRepository = module.get<Repository<GrupoEntity>>(getRepositoryToken(GrupoEntity));
    expedientesService = module.get<ExpedientesService>(ExpedientesService);
  });

  it('creates a group with uppercase name and linked expediente', async () => {
    const dto = { name: 'Grupo Demo', advisorName: 'Ana', createdBy: 'advisor' };

    const expectedGrupo = {
      id: 'uuid-123',
      name: 'GRUPO DEMO',
      advisorName: 'Ana',
      createdBy: 'advisor',
      status: GrupoStatus.FORMANDO,
      createdAt: new Date(),
      updatedAt: new Date(),
    };

    const expectedExpediente = {
      id: 'exp-uuid-123',
      groupId: 'uuid-123',
      title: 'GRUPO DEMO',
      status: 'En proceso',
      createdAt: new Date(),
      updatedAt: new Date(),
    };

    mockGrupoRepository.create.mockReturnValue(expectedGrupo);
    mockGrupoRepository.save.mockResolvedValue(expectedGrupo);
    mockExpedientesService.createForGroup.mockResolvedValue(expectedExpediente);

    const result = await service.create(dto);

    expect(result.name).toBe('GRUPO DEMO');
    expect(result.status).toBe(GrupoStatus.FORMANDO);
    expect(result.id).toBeTruthy();
    expect(result.expediente).toBeDefined();
    expect(result.expediente.title).toBe('GRUPO DEMO');
  });
});
