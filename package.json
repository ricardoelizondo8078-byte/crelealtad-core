{
  "name": "crelealtad-core",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema de gestión de créditos y cobranza",
  "scripts": {
    "dev": "node scripts/dev-runner.js",
    "dev:remote": "node scripts/dev-runner.js --remote",
    "dev:tailscale": "node scripts/dev-runner.js --tailscale",
    "security:secrets": "node scripts/check-secrets.js",
    "db:migrations:status": "npm --prefix apps/api run db:migrations:status --",
    "db:migrations:baseline": "npm --prefix apps/api run db:migrations:baseline --",
    "db:migrations:apply": "npm --prefix apps/api run db:migrations:apply --",
    "lint": "npm --prefix apps/mobile run lint",
    "typecheck": "npm --prefix apps/api run typecheck && npm --prefix apps/mobile run typecheck",
    "test:api": "npm --prefix apps/api run test:ci",
    "test:mobile": "npm --prefix apps/mobile run test",
    "test": "npm run test:api && npm run test:mobile",
    "verify": "npm run security:secrets && npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "exceljs": "^4.4.0"
  }
}
